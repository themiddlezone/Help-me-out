---
import Icon from './Icon.astro';

interface Props {
  text: string;
  label?: string;
}

const { text, label = 'Copy' } = Astro.props;
---

<button class="btn btn-icon btn-xs copy" type="button" data-copy={text} aria-label={label} title={label}>
  <Icon name="content_copy" class="idle" />
  <Icon name="check" class="done" />
</button>

<script>
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy]');
    if (!button) return;
    try {
      await navigator.clipboard.writeText(button.dataset.copy!);
    } catch {
      return;
    }
    button.dataset.copied = '';
    setTimeout(() => delete button.dataset.copied, 1600);
  });
</script>

<style>
  .copy {
    --btn-fg: var(--md-sys-color-on-surface-variant);
    display: inline-grid;
  }

  .copy :global(.icon) {
    grid-area: 1 / 1;
    transition:
      scale var(--spring-fast-spatial),
      opacity var(--spring-fast-effects);
  }

  .copy :global(.done) {
    scale: 0;
    opacity: 0;
  }

  .copy[data-copied] {
    --btn-fg: var(--md-sys-color-primary);
  }

  .copy[data-copied] :global(.idle) {
    scale: 0;
    opacity: 0;
  }

  .copy[data-copied] :global(.done) {
    scale: 1;
    opacity: 1;
  }
</style>
